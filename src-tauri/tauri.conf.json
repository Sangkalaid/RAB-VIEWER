{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAB VIEWER",
  "version": "0.1.3",
  "identifier": "com.rabviewer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RAB VIEWER",
        "width": 540,
        "height": 700,
        "minWidth": 540,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "RAB VIEWER",
    "copyright": "Copyright © 2026 RAB VIEWER",
    "category": "Business",
    "shortDescription": "RAB VIEWER",
    "longDescription": "RAB VIEWER desktop application integrated with MRV.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
