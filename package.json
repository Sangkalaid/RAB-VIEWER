{
  "name": "rab-viewer",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "test:ahsp-unit": "node --test api/google-apps-script/tests/ahsp-unit-mapping.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "gas:validate": "node scripts/gas/validate.mjs",
    "gas:push": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gas/deploy-staging.ps1 -PushOnly",
    "gas:deploy:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gas/deploy-staging.ps1 -Deploy",
    "gas:health": "node scripts/gas/health.mjs",
    "gas:test:staging": "node scripts/gas/staging-test.mjs",
    "gas:release:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gas/deploy-staging.ps1 -Deploy -RunTest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
